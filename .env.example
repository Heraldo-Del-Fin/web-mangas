# =============================================================================
# 1. BASE DE DATOS NEON (PostgreSQL Serverless)
# Copia tu cadena de conexión desde el Dashboard de Neon (https://console.neon.tech)
# =============================================================================
DATABASE_URL="postgresql://neondb_owner:tu_password@ep-tu-instancia.us-east-2.aws.neon.tech/neondb?sslmode=require"

# =============================================================================
# 2. ALMACENAMIENTO DE IMÁGENES EN CLOUDFLARE R2 (0$ Egress)
# Si estas variables están definidas, las portadas y páginas se suben a R2 y en
# la base de datos solo se guarda la URL pública (~60 bytes por imagen).
# Producción usa el binding R2_BUCKET; no necesita claves S3 en el Worker.
# Para pruebas locales usa npm run setup:local y config/local/.env.local.
# =============================================================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kuramanga-pages"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

