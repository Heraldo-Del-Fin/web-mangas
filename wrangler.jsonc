{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kurumanga",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {
    "R2_ACCOUNT_ID": "e500463ee947ed9f7530a55f5bc72688",
    "R2_BUCKET_NAME": "db-mangas",
    "R2_PUBLIC_URL": "https://pub-fb2319e68bce48608493b3d987bfdd68.r2.dev",
    "APP_ENV": "production",
    "DATABASE_HOST": "ep-soft-meadow-aojjnt3c.c-2.ap-southeast-1.aws.neon.tech"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": false
    }
  },
  "hyperdrive": [
    {
      "binding": "bd-manga",
      "id": "46fe7d438fe54b84bbc90b911129fd06",
      "localConnectionString": "postgresql://build:password@127.0.0.1:1/opennext_build"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "db-mangas"
    }
  ]
}
